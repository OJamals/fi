{
  "name": "@fi/provider-compat",
  "version": "1.0.1",
  "private": true,
  "description": "Canonical provider metadata and subscription-only HTTP and WebSocket transport compatibility for FI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/provider-settings.json"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:*"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "https-proxy-agent": "^9.1.0",
    "@deepseek-ai/schemastery": "workspace:~",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1"
  }
}
