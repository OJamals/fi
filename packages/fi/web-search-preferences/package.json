{
  "name": "@fi/web-search-preferences",
  "description": "FI-owned preferred web-search routing over free, API-key, and subscription providers",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "workspace:~",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*",
    "@deepseek-ai/dsh-launch-environment": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/dsh-web-search-deepseek": "workspace:*",
    "@deepseek-ai/dsh-web-search-exa": "workspace:*",
    "@deepseek-ai/dsh-web-search-perplexity": "workspace:*",
    "@fi/llm-antigravity": "workspace:^",
    "@fi/web-search-subscription": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-launch-environment": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/dsh-web-search-deepseek": "workspace:*",
    "@deepseek-ai/dsh-web-search-exa": "workspace:*",
    "@deepseek-ai/dsh-web-search-perplexity": "workspace:*",
    "@fi/llm-antigravity": "workspace:^",
    "@fi/web-search-subscription": "workspace:^"
  }
}
