exports[`enables synchronized pulse and dot motion only when reduced motion and forced colors are both inactive 1`] = `
"@keyframes fi-running-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

@keyframes fi-running-dot-lift {
  0%, 12% {
    transform: translateY(0);
    animation-timing-function: cubic-bezier(0.2, 0.65, 0.35, 1);
  }
  38% {
    transform: translateY(-2px);
    animation-timing-function: cubic-bezier(0.65, 0, 0.8, 0.35);
  }
  62% {
    transform: translateY(0);
    animation-timing-function: cubic-bezier(0.2, 0.65, 0.35, 1);
  }
  74% {
    transform: translateY(-0.65px);
    animation-timing-function: cubic-bezier(0.65, 0, 0.8, 0.35);
  }
  86%, 100% { transform: translateY(0); }
}

@media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
  .runningIcon {
    animation: fi-running-pulse 1.5s ease-in-out infinite;
  }

  .runningFiDot {
    animation: fi-running-dot-lift 1.5s ease-in-out infinite;
  }
}

"
`;

