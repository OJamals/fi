    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-workspace": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
